IDD_CONNECT DIALOGEX 20, 30, 360, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Amazon S3 - Connect"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_CATTREE,"SysTreeView32",0x800000 | 0x1 | 0x2 | 0x4 | 0x20 | WS_BORDER | WS_TABSTOP,7,7,112,207
    
    /* Page 0: Connection and AWS Profile */
    GROUPBOX        "AWS Credentials && Profile",IDC_STATIC,126,3,226,90
    LTEXT           "AWS &Profile (~/.aws/credentials):",IDC_STATIC,133,14,140,8
    COMBOBOX        IDC_PROFILES_COMBO,133,24,140,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Reload",IDC_SESS_RELOAD_AWS,278,23,66,13
    LTEXT           "&Access Key ID:",IDC_STATIC,133,40,90,8
    EDITTEXT        IDC_ACCESSKEY,133,50,211,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "&Secret Access Key:",IDC_STATIC,133,65,90,8
    EDITTEXT        IDC_SECRETKEY,133,75,192,12,ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON      "",IDC_PWDEYE,328,74,16,13

    GROUPBOX        "S3 Location && Region",IDC_STATIC,126,97,226,58
    LTEXT           "&Region:",IDC_STATIC,133,108,50,8
    COMBOBOX        IDC_REGION,133,118,90,100,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Initial &Bucket (empty = all):",IDC_STATIC,230,108,114,8
    EDITTEXT        IDC_BUCKET,230,118,114,12,ES_AUTOHSCROLL
    LTEXT           "Initial &Path:",IDC_STATIC,133,132,60,8
    EDITTEXT        IDC_PATH,133,141,211,12,ES_AUTOHSCROLL

    GROUPBOX        "Endpoint && Compatibility",IDC_STATIC,126,159,226,51
    LTEXT           "Custom &Endpoint (MinIO / R2 / Wasabi):",IDC_STATIC,133,169,180,8
    EDITTEXT        IDC_ENDPOINT,133,179,211,12,ES_AUTOHSCROLL
    CONTROL         "Path-Style addressing",IDC_PATHSTYLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,133,195,95,10
    CONTROL         "Use HTTPS / SSL",IDC_USESSL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,195,80,10

    /* Page 1: Saved Connections */
    LISTBOX         IDC_SESSIONS,126,3,150,207,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    PUSHBUTTON      "&New",IDC_SESS_NEW,282,3,66,14,NOT WS_VISIBLE
    PUSHBUTTON      "&Edit",IDC_SESS_EDIT,282,21,66,14,NOT WS_VISIBLE
    PUSHBUTTON      "&Save Current",IDC_SESS_SAVECUR,282,39,66,14,NOT WS_VISIBLE
    PUSHBUTTON      "&Delete",IDC_SESS_DELETE,282,57,66,14,NOT WS_VISIBLE
    PUSHBUTTON      "Re&name",IDC_SESS_RENAME,282,75,66,14,NOT WS_VISIBLE

    /* Bottom dialog buttons */
    DEFPUSHBUTTON   "&Connect",IDOK,185,223,52,14,WS_GROUP
    PUSHBUTTON      "&Save...",IDC_SESS_SAVE,242,223,50,14
    PUSHBUTTON      "&Close",IDCANCEL,297,223,52,14
END

IDD_PROGRESSDLG DIALOGEX 18, 80, 353, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Amazon S3 Transfer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
