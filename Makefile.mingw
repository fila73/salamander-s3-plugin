# Makefile for building Amazon S3 Plugin for Open Salamander via MinGW-w64 in WSL Ubuntu

CXX = x86_64-w64-mingw32-g++
WINDRES = x86_64-w64-mingw32-windres
DLLTOOL = x86_64-w64-mingw32-dlltool

CXXFLAGS = -O2 -std=c++17 -Wall -Wno-unknown-pragmas \
           -DWINVER=0x0601 -D_WIN32_WINNT=0x0601 -D_WIN32_IE=0x0800 \
           -D_CRT_SECURE_NO_WARNINGS -DS3_COMPATIBLE_WITH_500 -DENABLE_PROPERTYDIALOG \
           -I../shared -Isrc -Isrc/lang -I../../

LDFLAGS = -shared -static-libgcc -static-libstdc++ \
          -lbcrypt -lwinhttp -lws2_32 -lshlwapi -lcomctl32 -lole32 -lshell32 -lgdi32 -lmsimg32 -luxtheme -ldwmapi

OBJS = src/s3sigv4.o \
       src/awscred.o \
       src/s3conn.o \
       src/s3glue.o \
       src/s3.o \
       src/fs1.o \
       src/fs2.o \
       src/menu.o \
       ../shared/plugindarkmode.o \
       ../shared/dbg.o \
       ../shared/winliblt.o

RES = src/s3.res
LANG_RES_EN = src/lang/lang_en.res
LANG_RES_CS = src/lang/lang_cs.res

all: s3.spl English.slg Czech.slg

src/%.o: src/%.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

../shared/%.o: ../shared/%.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(DARKMODELIB_DIR)/src/%.o: $(DARKMODELIB_DIR)/src/%.cpp
	$(CXX) $(CXXFLAGS_DMLIB) -c $< -o $@

$(RES): src/s3.rc
	$(WINDRES) -I../shared -Isrc -i $< -O coff -o $@

$(LANG_RES_EN): src/lang/lang_en.rc
	$(WINDRES) -I../shared -Isrc -Isrc/lang -i $< -O coff -o $@

$(LANG_RES_CS): src/lang/lang_cs.rc
	$(WINDRES) -I../shared -Isrc -Isrc/lang -i $< -O coff -o $@

s3.spl: $(OBJS) $(RES) src/s3.def
	$(CXX) -shared -o $@ $(OBJS) $(RES) src/s3.def $(LDFLAGS)

English.slg: $(LANG_RES_EN)
	$(CXX) -shared -nostdlib -o $@ $(LANG_RES_EN) -Wl,-e,0

Czech.slg: $(LANG_RES_CS)
	$(CXX) -shared -nostdlib -o $@ $(LANG_RES_CS) -Wl,-e,0

clean:
	rm -f $(OBJS) $(RES) $(LANG_RES) s3.spl s3.slg
